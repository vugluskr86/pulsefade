# ID проекта и публичный ключ из панели GamePush → настройки проекта.
VITE_GAMEPUSH_ENABLED=true
VITE_GAMEPUSH_PROJECT_ID=12345
VITE_GAMEPUSH_PUBLIC_TOKEN=replace_with_public_token

# Для PULSEFADE оба формата выключены по умолчанию:
# preloader мешает мгновенному первому раунду, sticky закрывает игровое поле.
VITE_GAMEPUSH_PRELOADER=false
VITE_GAMEPUSH_STICKY=false
